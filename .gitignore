# Secrets. The API key lives only in .env locally and in a GitHub secret in CI.
.env

# Local DuckDB warehouse. It's a build artifact, always rebuildable from raw.
*.duckdb
*.duckdb.wal

# Cached raw API responses: keep the folder, ignore the JSON in it.
data/raw/*
!data/raw/.gitkeep

# Parquet exports for Power BI: keep the folder, ignore the files.
exports/*.parquet
!exports/.gitkeep

# dbt build artifacts
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
