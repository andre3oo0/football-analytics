# ---------------------------------------------------------------------------
# Required environment variables for the football data pipeline.
#
# HOW TO USE (local):
#   1. Copy this file:            cp .env.example .env
#   2. Register for a free key:   https://www.football-data.org/client/register
#   3. Paste your key below in .env (NOT here — .env is git-ignored).
#
# In CI, this same variable is provided by a GitHub Actions repository secret.
# NEVER put a real key in this file — it is committed to the repo.
# ---------------------------------------------------------------------------

# football-data.org REST API v4 token, sent as the X-Auth-Token header.
# Free tier hard limit: 10 requests/minute.
FOOTBALL_DATA_API_KEY=your_api_key_here
