# Environment variables for the pipeline.
#
# Local setup:
#   1. copy this file:          cp .env.example .env
#   2. get a free key:          https://www.football-data.org/client/register
#   3. paste your key into .env (not here; .env is git-ignored)
#
# In CI the same variable comes from a GitHub Actions secret.
# Don't put a real key in this file: it's committed.

# football-data.org API token, sent as the X-Auth-Token header.
# Free tier limit: 10 requests/minute.
FOOTBALL_DATA_API_KEY=your_api_key_here
